rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pantry to Plate: each signed-in person can read and write only their own planner.
    match /pantryToPlate/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shared households: members read and write; someone with the invite code can add themselves.
    match /households/{code} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members);
    }
    // If this project also serves Anchor, keep Anchor's existing rules alongside this block.
  }
}
